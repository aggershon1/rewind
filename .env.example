# --- Spotify (from your app at developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Anthropic (from console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5

# --- App ---
PORT=8888
